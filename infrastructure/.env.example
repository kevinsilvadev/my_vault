# Copie para infrastructure/.env e preencha. Nunca versione o .env.
POSTGRES_USER=myvault
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=myvault
POSTGRES_PORT=5432

# Usado apenas pelo perfil "api" (API em contêiner).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
API_PORT=3000
CORS_ORIGINS=
TRUST_PROXY=1
REQUIRE_HTTPS=true
# Deixe "true" apenas até criar a sua conta; depois volte para "false".
ALLOW_REGISTRATION=false
LOG_LEVEL=info
