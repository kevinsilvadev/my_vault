# Copie para server/.env para desenvolvimento local. Nunca versione o .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://myvault:troque-por-uma-senha-forte@localhost:5432/myvault?schema=public

# Mínimo de 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens permitidas (separadas por vírgula). Apps nativos não precisam de CORS.
CORS_ORIGINS=

# false | true | número de proxies confiáveis (ex.: 1 atrás de um proxy reverso)
TRUST_PROXY=false
# Em produção o padrão é true; em desenvolvimento, false.
REQUIRE_HTTPS=false
ALLOW_REGISTRATION=true
LOG_LEVEL=debug
